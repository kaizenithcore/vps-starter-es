# Configuración opcional de docker-compose.yml.
# Cópialo a .env y cambia solo lo que necesites:  cp .env.example .env
# Sin .env, todo funciona con los valores por defecto.

# Dónde escucha el panel de Uptime Kuma.
#   127.0.0.1  solo dentro del servidor (por defecto, lo más seguro)
#   0.0.0.0    también desde Internet. Ponlo SOLO después de crear en el
#              firewall de Hostinger la regla del puerto 3001 limitada a tu IP
#              (guía 04, paso 3).
KUMA_BIND=127.0.0.1

# Puerto del panel.
KUMA_PORT=3001

# Zona horaria para las fechas de los avisos, por ejemplo Europe/Madrid,
# America/Mexico_City o America/Bogota.
TZ=UTC
